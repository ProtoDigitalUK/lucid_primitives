<div
    data-store="example"
    data-state--boolean="false"
    data-state--number="1"
    data-state--string="hello world"
    data-state--object='{"hello":"world", "world":"hello"}'
    data-state--array='[false,"world"]'
    data-bind--data-boolean="$boolean"
    data-bind--data-number="$number"
    data-bind--data-string="$string"
    data-bind--data-object-hello="$object.world"
    data-bind--data-array-hello="$array[0]"
    data-bind--data-custom-state-attribute="$customState"
    data-events--scroll="@handleScroll"
    data-effects="#elementEffect"
    class="data-[state--boolean=true]:bg-red-500"
>
    <span data-bind--data-boolean="$boolean" data-ref="#span[]"
    ></span>
    <span data-bind--data-number="$number" data-ref="#span[]"
    ></span>
    <span data-bind--data-string="$string" data-ref="#span[]"
    ></span>
    <span
        data-bind--data-object-hello="$object.hello"
        data-ref="#span[]"></span>
    <span
        data-trap="$array[0]"
        data-bind--data-array-hello="$array[0]"
        data-ref="#span[]"></span>
    <button
        data-events--click="@handleClick"
        data-dom--text="@contentCopy"
        data-ref="#button"
        class="cursor-pointer pointer-events-auto"
    >
        Show Content
    </button>
    Parent Element (scoped)
    <!-- Sub Element -->
    <div
        data-store="nested"
        data-state--name="I am nested!"
        data-ref="example:#div"
        data-bind--name="$name"
        data-bind--boolean="example:$boolean"
    >
        Single Nested (not scoped)
        <div
            data-store="doubleNested"
            data-state--name="I am double nested!"
            data-bind--name="$name"
            data-bind--boolean="example:$boolean"
        >
            Double Nested (not scoped)
        </div>
    </div>
</div>
