<header
    data-store="nav"
    data-state--open="false"
    class="h-10 bg-black text-white"
    data-effects="#customEffect"
    data-events--document.scroll="@documentScroll"
>
    <div class="flex justify-between items-center">
        <div class="flex items-center">
            <h1>Catalyst</h1>
            <div data-ref="#testEleRefresh" class="ml-2.5">
                <button
                    data-store="testreplace"
                    data-events--click="nav:@oldClick"
                >
                    before
                </button>
            </div>
            <button
                data-events--click="@replaceChild"
                class="ml-2.5"
            >
                Refresh Catalyst
            </button>
        </div>
        <button
            data-events--click="@toggle"
            data-bind--aria-expanded="$open"
            data-bind--aria-label="$ariaLabel"
            aria-controls="main-nav"
        >
            <span data-dom--text="@buttonLabel">
                Open Navigation
            </span>
        </button>
    </div>
    <nav
        id="main-nav"
        data-bind--aria-hidden="@closed"
        class="[&[aria-hidden='false']]:translate-x-0 fixed inset-0 top-10 bg-gray-800 z-50 transition-transform duration-200 translate-x-full p-2.5"
        aria-label="Main navigation"
        aria-hidden="true"
        data-trap--both="$open"
    >
        <a href="/">Home</a>
        <a href="/about">About</a>

        <input
            type="text"
            class="focus:ring-4 ring-red-500"
            data-dom--focus="$open"
        />
    </nav>
</header>
